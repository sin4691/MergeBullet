/* 기준 해상도 1920x1080 (PanelSettings: Scale With Screen Size) */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px 36px;
}

/* ---------- 체력 · 레벨 ---------- */

.player-info {
    width: 420px;
}

.hp-bar {
    height: 36px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 8px;
    overflow: hidden;
}

/* 너비(%)와 색은 GameHud.cs가 체력 비율에 맞춰 바꾼다 */
.hp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(77, 217, 102);
}

.hp-text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.level-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.level-text {
    width: 72px;
    margin: 0;
    padding: 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 214, 77);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.xp-bar {
    flex-grow: 1;
    height: 12px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 6px;
    overflow: hidden;
}

/* 너비(%)는 GameHud.cs가 경험치 비율에 맞춰 바꾼다 */
.xp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: rgb(255, 214, 77);
}

.stats {
    flex-direction: row;
}

.stat {
    margin-left: 32px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

/* ---------- 보스 체력 ---------- */

.boss-bar {
    display: none;
    position: absolute;
    top: 110px;
    left: 25%;
    right: 25%;
    align-items: center;
}

.boss-name {
    margin-bottom: 4px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 90, 110);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.boss-track {
    width: 100%;
    height: 18px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 9px;
    overflow: hidden;
}

/* 너비(%)는 GameHud.cs가 보스 체력 비율에 맞춰 바꾼다 */
.boss-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(220, 40, 70);
}

/* ---------- 전체 화면 오버레이 (레벨업, 게임 오버) ---------- */

/* 필요할 때만 GameHud.cs가 display: flex로 켠다 */
.overlay {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.overlay-title {
    font-size: 80px;
    -unity-font-style: bold;
    color: rgb(255, 214, 77);
}

.overlay-hint {
    margin: 4px 0 36px 0;
    font-size: 26px;
    color: rgb(220, 220, 220);
}

.choice-row {
    flex-direction: row;
}

.choice {
    width: 360px;
    height: 240px;
    margin: 0 18px;
    padding: 20px;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    border-width: 3px;
    border-color: rgb(255, 214, 77);
    background-color: rgb(40, 44, 58);
}

.choice:hover {
    background-color: rgb(62, 68, 90);
}

.choice-key {
    font-size: 22px;
    color: rgb(160, 160, 170);
}

.choice-title {
    margin: 8px 0;
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.choice-desc {
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(210, 210, 220);
}

.game-over-title {
    font-size: 96px;
    color: rgb(255, 255, 255);
}

.final-text {
    margin: 8px 0 36px 0;
    font-size: 32px;
    -unity-text-align: middle-center;
    color: rgb(230, 230, 230);
}

/* ---------- 시작 화면 · 결과 ---------- */

/* 시작 화면은 게임 화면이 비치지 않게 더 어둡게 */
.title {
    background-color: rgba(0, 0, 0, 0.85);
}

/* 로비 씬에서는 화면 전체가 이 오버레이라 항상 보인다 (.overlay 기본값 display: none을 덮어씀) */
.overlay.lobby {
    display: flex;
}

.game-title {
    font-size: 110px;
    color: rgb(255, 255, 255);
}

.coin-text {
    margin: 4px 0 28px 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 214, 77);
}

/* ---------- 로비 상점 ---------- */

.shop {
    width: 820px;
    margin-bottom: 32px;
    padding: 16px 24px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.06);
}

.shop-title {
    margin-bottom: 8px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(160, 160, 170);
}

.shop-row {
    flex-direction: row;
    align-items: center;
    height: 56px;
}

.shop-name {
    width: 200px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.shop-effect {
    flex-grow: 1;
    font-size: 22px;
    color: rgb(210, 210, 220);
}

.shop-buy {
    width: 120px;
    height: 44px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 214, 77);
}

.button-row {
    flex-direction: row;
}

.button-row > .restart-button {
    margin: 0 12px;
}

.restart-button {
    width: 300px;
    height: 76px;
    font-size: 30px;
    -unity-font-style: bold;
}
