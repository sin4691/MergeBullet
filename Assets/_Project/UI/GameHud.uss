/* 기준 해상도 1920x1080 (PanelSettings: Scale With Screen Size) */

/* UI 전체 기본 폰트 (하위 요소가 상속). UI-Latin은 한중일 폰트를 대체 폰트로 갖고 있어 어떤 글자도 깨지지 않는다.
   화면별로 L10n.ApplyFont가 지금 언어에 맞는 폰트로 덮어쓴다. 폰트 에셋은 Setup Localization 메뉴가 만든다 */
:root {
    -unity-font-definition: url("/Assets/_Project/Fonts/Assets/UI-Latin.asset");
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px 36px;
}

/* ---------- 체력 · 레벨 ---------- */

.player-info {
    width: 420px;
}

.hp-bar {
    height: 36px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 8px;
    overflow: hidden;
}

/* 너비(%)와 색은 GameHud.cs가 체력 비율에 맞춰 바꾼다 */
.hp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(77, 217, 102);
}

.hp-text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.level-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.level-text {
    width: 72px;
    margin: 0;
    padding: 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 214, 77);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.xp-bar {
    flex-grow: 1;
    height: 12px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 6px;
    overflow: hidden;
}

/* 너비(%)는 GameHud.cs가 경험치 비율에 맞춰 바꾼다 */
.xp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background-color: rgb(255, 214, 77);
}

.stats {
    flex-direction: row;
}

.stat {
    margin-left: 32px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

/* ---------- 보스 체력 ---------- */

.boss-bar {
    display: none;
    position: absolute;
    top: 110px;
    left: 25%;
    right: 25%;
    align-items: center;
}

.boss-name {
    margin-bottom: 4px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 90, 110);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.boss-track {
    width: 100%;
    height: 18px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 9px;
    overflow: hidden;
}

/* 너비(%)는 GameHud.cs가 보스 체력 비율에 맞춰 바꾼다 */
.boss-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(220, 40, 70);
}

/* ---------- 전체 화면 오버레이 (레벨업, 게임 오버) ---------- */

/* 필요할 때만 GameHud.cs가 display: flex로 켠다 */
.overlay {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.overlay-title {
    font-size: 80px;
    -unity-font-style: bold;
    color: rgb(255, 214, 77);
}

.overlay-hint {
    margin: 4px 0 36px 0;
    font-size: 26px;
    color: rgb(220, 220, 220);
}

.choice-row {
    flex-direction: row;
}

.choice {
    width: 360px;
    height: 240px;
    margin: 0 18px;
    padding: 20px;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    border-width: 3px;
    border-color: rgb(255, 214, 77);
    background-color: rgb(40, 44, 58);
}

.choice:hover {
    background-color: rgb(62, 68, 90);
}

.choice-key {
    font-size: 22px;
    color: rgb(160, 160, 170);
}

/* 긴 이름(Скорострельность 등)은 카드 안에서 줄바꿈 */
.choice-title {
    margin: 8px 0;
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.choice-desc {
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(210, 210, 220);
}

.game-over-title {
    font-size: 96px;
    color: rgb(255, 255, 255);
}

.final-text {
    margin: 8px 0 36px 0;
    font-size: 32px;
    -unity-text-align: middle-center;
    color: rgb(230, 230, 230);
}

/* ---------- 휴대폰 가상 조이스틱 (TouchJoystick) ---------- */

/* HUD 맨 뒤에 화면 전체로 깔려 터치를 받는다. 버튼·카드가 위에 있으면 그쪽이 먼저 받는다 */
.joystick-area {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 누른 자리에 나타나는 받침. 크기 = 2 x TouchJoystick.Radius */
.joystick-base {
    position: absolute;
    width: 220px;
    height: 220px;
    align-items: center;
    justify-content: center;
    border-radius: 110px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(255, 255, 255, 0.08);
}

.joystick-knob {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background-color: rgba(255, 255, 255, 0.45);
}

/* ---------- 로비: 타이틀 · 메뉴 · 하위 화면 ---------- */

.lobby {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 배경 연출(TitleBackground)은 화면 전체를 덮고, 클릭은 받지 않는다 */
.title-background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 화면 하나. LobbyScreen.cs가 display로 하나만 보이게 하고, 나타날 때 opacity를 0 → 1로 바꿔 서서히 보인다 */
.page {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.game-title {
    font-size: 110px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    /* 글자 테두리로 배경의 공 위에서도 또렷하게 */
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.title-page .game-title {
    font-size: 150px;
}

.title-press {
    margin-top: 48px;
    font-size: 34px;
    color: rgb(255, 214, 77);
}

/* 메인 메뉴: 왼쪽 정렬 세로 목록 */
.menu-page {
    align-items: flex-start;
    padding-left: 180px;
}

.menu-logo {
    margin-bottom: 56px;
}

.menu-item {
    margin: 6px 0;
    padding: 6px 0 6px 20px;
    border-width: 0 0 0 6px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    font-size: 52px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(170, 170, 180);
    transition-property: color, translate, border-color;
    transition-duration: 0.12s;
}

/* 선택된 항목: 노란색 + 왼쪽 막대 + 살짝 오른쪽으로 */
.menu-item.selected {
    color: rgb(255, 214, 77);
    border-color: rgb(255, 214, 77);
    translate: 16px 0;
}

/* 오른쪽 위 지갑 (코인 · 최고 기록) */
.wallet {
    position: absolute;
    top: 36px;
    right: 48px;
    align-items: flex-end;
}

.wallet .coin-text {
    margin: 0;
}

.best-text {
    margin-top: 4px;
    font-size: 24px;
    color: rgb(200, 200, 210);
}

.page-title {
    margin-bottom: 28px;
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

/* 하위 화면 아래쪽 뒤로 가기 */
.back-button {
    margin-top: 20px;
    padding: 6px 20px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 26px;
    color: rgb(170, 170, 180);
}

.back-button:hover {
    color: rgb(255, 255, 255);
}

.start-button {
    margin-top: 36px;
}

/* 캐릭터 카드 */
.character-list {
    flex-direction: row;
}

.character-card {
    width: 340px;
    min-height: 380px;
    margin: 0 18px;
    padding: 28px 24px;
    align-items: center;
    border-radius: 16px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(40, 44, 58, 0.9);
}

.character-card:hover {
    background-color: rgba(62, 68, 90, 0.95);
}

.character-card.selected {
    border-color: rgb(255, 214, 77);
}

.card-swatch {
    width: 110px;
    height: 110px;
    margin-bottom: 24px;
    border-radius: 55px;
}

.card-name {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.card-desc {
    flex-grow: 1;
    margin: 12px 0 20px 0;
    font-size: 24px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: rgb(210, 210, 220);
}

/* 설정 */
.settings-row {
    flex-direction: row;
    align-items: center;
    min-height: 60px;
}

.language-dropdown {
    flex-grow: 1;
    font-size: 24px;
}

.settings-slider {
    flex-grow: 1;
}

.settings-toggle {
    flex-grow: 1;
}

/* 오른쪽 위 일시정지 버튼 (휴대폰에서 누르기 쉽게 큼직하게) */
.pause-button {
    width: 64px;
    height: 56px;
    margin-left: 28px;
    font-size: 26px;
    -unity-font-style: bold;
}

#pause .settings-panel {
    margin: 12px 0 28px 0;
}

.coin-text {
    margin: 4px 0 28px 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 214, 77);
}

/* ---------- 로비 상점 ---------- */

.shop {
    width: 820px;
    margin-bottom: 32px;
    padding: 16px 24px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.06);
}

.shop-title {
    margin-bottom: 8px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(160, 160, 170);
}

/* 언어마다 글 길이가 달라서(독일어·폴란드어는 영어의 1.3~1.5배) 높이는 최소값만 두고,
   남는 폭은 설명 칸만 나눠 쓴다. 이름·견본·버튼은 줄어들지 않고, 긴 설명은 다음 줄로 넘긴다 */
.shop-row {
    flex-direction: row;
    align-items: center;
    min-height: 52px;
    padding: 2px 0;
}

.shop-name {
    width: 220px;
    flex-shrink: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    white-space: normal;
}

.shop-effect {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: 12px;
    font-size: 22px;
    color: rgb(210, 210, 220);
    white-space: normal;
}

/* 버튼 글이 긴 언어("Desbloquear 100")에서는 버튼이 넓어진다 */
.shop-buy {
    min-width: 120px;
    flex-shrink: 0;
    height: 44px;
    padding: 0 12px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 214, 77);
}

/* 캐릭터 줄: 색 견본 · 이름 · 설명 · 선택/해금 버튼. 선택된 줄은 테두리로 표시 */
.button-row {
    flex-direction: row;
}

.button-row > .restart-button {
    margin: 0 12px;
}

/* 긴 문구(Tentar de novo (R) 등)에서는 버튼이 넓어진다 */
.restart-button {
    min-width: 300px;
    padding: 0 24px;
    height: 76px;
    font-size: 30px;
    -unity-font-style: bold;
}
