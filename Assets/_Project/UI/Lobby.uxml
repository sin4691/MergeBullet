<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameHud.uss" />
    <ui:VisualElement name="lobby" class="overlay title lobby">
        <!-- 언어 목록은 LobbyScreen.cs가 각 언어 자신의 이름으로 채운다 -->
        <ui:DropdownField name="language-dropdown" class="language-dropdown" />
        <ui:Label class="overlay-title game-title" text="MERGE BULLET" />
        <ui:Label name="coins" class="coin-text" text="0 coins" />
        <ui:Label name="best" class="final-text" text="" />
        <ui:VisualElement name="characters" class="shop">
            <ui:Label name="characters-title" class="shop-title" text="CHARACTER" />
            <!-- 줄은 LobbyScreen.cs가 캐릭터 수만큼 만든다 -->
            <ui:VisualElement name="character-list" class="shop-list" />
        </ui:VisualElement>
        <ui:VisualElement name="shop" class="shop">
            <ui:Label name="upgrades-title" class="shop-title" text="UPGRADES" />
            <!-- 줄은 LobbyScreen.cs가 강화 종류만큼 만든다 -->
            <ui:VisualElement name="shop-list" class="shop-list" />
        </ui:VisualElement>
        <ui:Button name="start-button" class="restart-button" text="Start (Space)" />
    </ui:VisualElement>
</ui:UXML>
