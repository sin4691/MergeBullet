      m_Items: []
  - m_Id: 1178985124081667
    m_Localized: "\uCD5C\uB300 \uB808\uBCA8 \uD3ED\uBC1C\xB7\uBC88\uAC1C\uC758 \uBC94\uC704\uC640 \uD53C\uD574 {0}\uBC30"
