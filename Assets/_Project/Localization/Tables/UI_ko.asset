      m_Items: []
  - m_Id: 1178985124081671
    m_Localized: "\uCD1D\uC54C\uC774 \uC0AC\uB77C\uC9C0\uAE30\uAE4C\uC9C0\uC758 \uC2DC\uAC04\uC774 {0}\uBC30 \uB298\uC5B4\uB0A9\uB2C8\uB2E4"
