      m_Items: []
  - m_Id: 1178985124081668
    m_Localized: "\uCD1D\uC54C\uC774 \uD569\uCCD0\uC9C8 \uB54C\uB9C8\uB2E4 \uADF8 \uC790\uB9AC\uC5D0\uC11C \uC791\uC740 \uD3ED\uBC1C\uC774 \uC77C\uC5B4\uB0A9\uB2C8\uB2E4"
