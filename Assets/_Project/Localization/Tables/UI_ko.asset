      m_Items: []
  - m_Id: 1178985124081666
    m_Localized: "\uD295\uAE38 \uB54C\uB9C8\uB2E4 \uADF8 \uCD1D\uC54C\uC758 \uD53C\uD574\uAC00 {0}\uC529 \uB298\uC5B4\uB0A9\uB2C8\uB2E4"
